# Runtime output and large local video assets
reports/*.json
!reports/performance.json
reports/*.pdf
reports/*.jpg
reports/*.mp4
videos/demo/*
!videos/demo/.gitkeep
models/*.pt
!models/.gitkeep

# Keep local incident/event state out of version control, while retaining the
# empty directory through its placeholder.
data/*.json
!data/.gitkeep
