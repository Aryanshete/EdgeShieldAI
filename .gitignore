# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/

# Virtual environments and local configuration
.venv/
venv/
.env

# Tooling and OS files
.streamlit/secrets.toml
Ultralytics/
.DS_Store
Thumbs.db
scratch/
